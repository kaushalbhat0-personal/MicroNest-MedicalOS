# Preview environment template. Copy to .env.preview and fill in.
# NEVER commit .env.preview. NEVER reuse production secrets here.
# This stack uses isolated preview resources only (healthcare_os_preview).

# 32+ bytes. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
PREVIEW_JWT_SECRET=change-me-preview-jwt-secret-min-32-bytes-xxxx
# Database app-role password (preview only, never production).
PREVIEW_APP_PASSWORD=change-me-preview-app-password
# Database owner password for the preview database (migrations only).
PREVIEW_OWNER_PASSWORD=change-me-preview-owner-password
# MinIO root credentials for preview object storage (preview only).
PREVIEW_MINIO_ROOT_USER=preview-minio-admin
PREVIEW_MINIO_ROOT_PASSWORD=change-me-preview-minio-password-min-8-chars
# Public API URL baked into the preview web image at build time.
PREVIEW_WEB_API_URL=http://localhost:8001
