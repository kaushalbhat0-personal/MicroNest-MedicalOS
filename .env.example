# Copy to .env and fill in. NEVER commit .env.
# Owner URL is for migrations/seeds only. The app itself runs on APP_DATABASE_URL.

# Owner (migrations, RLS setup). Example:
# OWNER_DATABASE_URL=postgresql+psycopg2://hos_owner:change-me@localhost:5432/healthcare_os
OWNER_DATABASE_URL=
# App role (least privilege, RLS-enforced). Example:
# APP_DATABASE_URL=postgresql+psycopg2://hos_app:change-me@localhost:5432/healthcare_os
APP_DATABASE_URL=

APP_ROLE_PASSWORD=change-me-app-role
JWT_SECRET=change-me-min-32-chars-jwt-secret-please
ENV=dev
API_HOST=127.0.0.1
API_PORT=8000

# Dev-only notification adapter. Must stay "true" only in dev; prod refuses to boot with it.
DEV_NOTIFICATIONS_ALLOW=true

# Local storage adapter root (dev only; gitignored)
STORAGE_LOCAL_ROOT=./var/storage

# Browser origins allowed to call the API with credentials (explicit, no "*").
# Dev: ["http://localhost:3000"]. Prod: the real web/portal origins.
# ALLOWED_ORIGINS=["http://localhost:3000"]

# Web app
WEB_PORT=3000
# Browser API base (P3.7D.2 same-origin proxy):
# - Empty / unset → relative /api/* via Next rewrite (recommended for Vercel Preview).
# - Absolute URL → direct FastAPI (legacy local / Playwright API helpers).
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
# Server-only rewrite upstream (never NEXT_PUBLIC). Allowlisted only:
# http://127.0.0.1:8000 | http://localhost:8000 | https://micronest-medicalos.onrender.com
# API_REWRITE_UPSTREAM=http://127.0.0.1:8000

# --- P2.4/P2.5 SaaS subscription payments (clinic tenant billing, not patient AR) ---
# Default mock provider for local/tests. Never commit live Razorpay secrets.
# Production MUST set SAAS_PAYMENT_PROVIDER=razorpay (mock fallback forbidden).
#SAAS_PAYMENT_PROVIDER=mock
#SAAS_PAYMENT_WEBHOOK_SECRET=mock-webhook-secret
#SAAS_PAYMENT_WEBHOOK_SECRET_PREVIOUS=
#SAAS_GRACE_DAYS=7
#SAAS_WEBHOOK_MAX_ATTEMPTS=8
# Sandbox only outside production (rzp_test_* keys required):
#SAAS_PAYMENT_PROVIDER=razorpay
#RAZORPAY_KEY_ID=rzp_test_xxx
#RAZORPAY_KEY_SECRET=
#RAZORPAY_WEBHOOK_SECRET=
#RAZORPAY_WEBHOOK_SECRET_PREVIOUS=

# --- P7 deployment profiles (ENV=dev|test|preview|prod|production) ---
# DEPLOYMENT=local|cloud|private|onprem (preview requires cloud;
# production forbids local). Validated at boot; see config.validate_for_boot.
#DEPLOYMENT=local
# Preview/production additionally require:
# APP_DATABASE_URL (preview db name must contain "preview")
# COOKIE_SECURE=true (preview: only localhost origins may use false)
# ALLOWED_ORIGINS=["https://portal.example.com"] (explicit, no "*")
# NOTIFY_PROVIDER=none (dev-console is dev/test only)
# STORAGE_ADAPTER=s3 (+ S3_ENDPOINT_URL/S3_BUCKET/S3_ACCESS_KEY/S3_SECRET_KEY)
# production-cloud additionally requires DB_SSL_REQUIRE=true (?sslmode=require).

# =============================================================================
# CLOUD: Vercel (web) + Render (API/worker) + Supabase (Postgres + Storage/S3)
# Fill and mirror into each host's env/secret UI. Never commit real secrets.
# =============================================================================

#DEPLOYMENT=cloud
#ENV=prod
#COOKIE_SECURE=true
#COOKIE_DOMAIN=
#DB_SSL_REQUIRE=true
#DEV_NOTIFICATIONS_ALLOW=false
#NOTIFY_PROVIDER=none

# Supabase Postgres (create hos_owner + hos_app roles; ?sslmode=require)
# SUPABASE_PROJECT_REF = ref id only (not a full URL)
SUPABASE_PROJECT_REF=
SUPABASE_URL=
SUPABASE_DB_REGION=
# Management PAT (sbp_*) — not an S3 key
#SUPABASE_ACCESS_TOKEN=
# Session pooler usernames: hos_owner.<ref> / hos_app.<ref> on :5432
OWNER_DATABASE_URL_CLOUD=
APP_DATABASE_URL_CLOUD=
APP_ROLE_PASSWORD_CLOUD=

# Supabase Storage (S3-compatible) — STORAGE_ADAPTER=s3 on Render
STORAGE_ADAPTER_CLOUD=s3
S3_ENDPOINT_URL=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_USE_TLS=true
S3_ENSURE_BUCKET=false

# Render API (do not blank local API_PUBLIC_URL — use *_CLOUD)
RENDER_API_SERVICE_NAME=
API_PUBLIC_URL_CLOUD=
JWT_SECRET_CLOUD=
ALLOWED_ORIGINS_CLOUD=

# Vercel web (build-time)
VERCEL_PROJECT_NAME=
NEXT_PUBLIC_API_URL_CLOUD=
WEB_PUBLIC_URL=
