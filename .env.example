# Copy to .env and fill in. NEVER commit .env.
# Owner URL is for migrations/seeds only. The app itself runs on APP_DATABASE_URL.

# Owner (migrations, RLS setup). Example:
# OWNER_DATABASE_URL=postgresql+psycopg2://hos_owner:change-me@localhost:5432/healthcare_os
OWNER_DATABASE_URL=
# App role (least privilege, RLS-enforced). Example:
# APP_DATABASE_URL=postgresql+psycopg2://hos_app:change-me@localhost:5432/healthcare_os
APP_DATABASE_URL=

APP_ROLE_PASSWORD=change-me-app-role
JWT_SECRET=change-me-min-32-chars-jwt-secret-please
ENV=dev
API_HOST=127.0.0.1
API_PORT=8000

# Dev-only notification adapter. Must stay "true" only in dev; prod refuses to boot with it.
DEV_NOTIFICATIONS_ALLOW=true

# Local storage adapter root (dev only; gitignored)
STORAGE_LOCAL_ROOT=./var/storage

# Web app
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
